# ============================================================================
# CritHit! — Variáveis de Ambiente (Exemplo para Desenvolvimento Local)
# Copie este arquivo para `infra/.env` e ajuste segredos antes de rodar em prod.
# ============================================================================

# --- PostgreSQL 16 + pgvector ---
POSTGRES_DB=crithit
POSTGRES_USER=crithit
POSTGRES_PASSWORD=crithit_dev_password
POSTGRES_PORT=5432

# --- Redis 7 ---
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend API / Worker (Spring Boot 3 / Java 21) ---
API_PORT=8080
SPRING_PROFILES_ACTIVE=local

# JWT (troque por segredo aleatório >= 32 bytes em produção)
JWT_SECRET=crithit-dev-jwt-secret-change-me-with-at-least-32-chars
JWT_ISSUER=crithit-api
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Hash anônimo de visitantes (views, likes, comentários)
VISITOR_HASH_SALT=crithit-dev-visitor-salt-change-me

# Seed inicial do Editor-Chefe (/admin) — usado na Fase 3 via BCrypt
ADMIN_SEED_EMAIL=editor@crithit.com.br
ADMIN_SEED_PASSWORD=ChangeMe123!
ADMIN_SEED_NAME=Rafael Mendes

# Provedor LLM e Embeddings (OpenAI-compatible REST API)
LLM_PROVIDER_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4o-mini
LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_DIMENSIONS=1536
LLM_TIMEOUT_MS=25000
LLM_MAX_RETRIES=3

# Worker RSS (Virtual Threads + Rome + JSoup)
RSS_CRON_EXPRESSION=0 */15 * * * *
RSS_MAX_CONCURRENT_FETCHES=12
RSS_CONNECT_TIMEOUT_MS=5000
RSS_READ_TIMEOUT_MS=10000
DEDUP_SIMILARITY_THRESHOLD=0.82
DEDUP_WINDOW_HOURS=72

# --- Frontend Web + BFF (Next.js App Router) ---
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_WEB_PUBLIC_URL=http://localhost:3000
INTERNAL_API_BASE_URL=http://api:8080
REVALIDATE_WEBHOOK_URL=http://web:3000/api/revalidate
REVALIDATE_SECRET=crithit-dev-revalidate-secret-change-me

# --- Notificações Editoriais (Discord & Telegram - Opcionais) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
