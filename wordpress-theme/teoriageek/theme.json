{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "68ch",
      "wideSize": "1280px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "palette": [
        { "slug": "tg-primary", "color": "#1D4ED8", "name": "Azul Primário Teoria Geek" },
        { "slug": "tg-primary-bright", "color": "#2563EB", "name": "Azul Interativo" },
        { "slug": "tg-accent", "color": "#FACC15", "name": "Amarelo Destaque Teoria Geek" },
        { "slug": "tg-accent-strong", "color": "#EAB308", "name": "Amarelo Ouro" },
        { "slug": "tg-text", "color": "#0B0F19", "name": "Texto Escuro Alto Contraste" },
        { "slug": "tg-bg", "color": "#F8FAFC", "name": "Fundo Base Claro" },
        { "slug": "tg-surface", "color": "#FFFFFF", "name": "Superfície Clara" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "'Barlow Condensed', Impact, sans-serif",
          "slug": "headline",
          "name": "Manchete (Barlow Condensed)"
        },
        {
          "fontFamily": "'Space Grotesk', system-ui, sans-serif",
          "slug": "sans",
          "name": "Interface (Space Grotesk)"
        },
        {
          "fontFamily": "'Plus Jakarta Sans', system-ui, sans-serif",
          "slug": "reading",
          "name": "Leitura (Plus Jakarta Sans)"
        },
        {
          "fontFamily": "'JetBrains Mono', monospace",
          "slug": "mono",
          "name": "Metadados (JetBrains Mono)"
        }
      ]
    }
  }
}
